<!DOCTYPE html>
<html>
<head>
  <title><%= t('layouts.index.title', page_title: @page_title) %></title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>

<div id="header">
  <h1><%= t('layouts.index.header_title') %></h1>
</div>

<div id="main">
  <div id="flash_messages">
    <% flash.each do |key, message| %>
      <div class="<%= key %>"><%= message %></div>
    <% end %>
  </div>

  <div id="content">
    <%= yield %>
  </div>
  <div class="clear"></div>
</div>

<div id="footer">
</div>

</body>
</html>
