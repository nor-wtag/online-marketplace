<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h1 class="mb-4 text-center"><%= t('cart.title') %></h1>
      <% if @cart_items.empty? %>
        <p class="text-center"><%= t('cart.empty') %></p>
      <% else %>
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th><%= t('cart.product') %></th>
              <th><%= t('cart.quantity') %></th>
              <th><%= t('cart.price') %></th>
              <th><%= t('cart.total') %></th>
              <th><%= t('cart.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% @cart_items.each do |item| %>
              <tr>
                <td><%= item.product.title %></td>
                <td>
                  <%= form_with url: cart_item_path(item), method: :patch, local: true do |f| %>
                    <%= f.number_field :quantity, value: item.quantity, min: 1, class: 'form-control' %>
                    <%= f.submit t('cart.update'), class: 'btn btn-primary btn-sm mt-1' %>
                  <% end %>
                </td>
                <td><%= number_to_currency(item.product.price) %></td>
                <td><%= number_to_currency(item.product.price * item.quantity) %></td>
                <td>
                  <% if can?(:destroy, item) %>
                    <%= link_to t('cart.remove'), delete_cart_item_path(item), method: :get, class: "btn btn-danger btn-sm" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="text-end"><strong><%= t('cart.total_label') %>:</strong> <%= number_to_currency(current_user.cart.cart_items.sum { |item| item.quantity * item.product.price }) %></p>
        <div class="d-flex justify-content-between">
          <%= button_to t('cart.place_order'), orders_path, method: :post, class: 'btn btn-primary' %>
          <div>
            <%= link_to t('cart.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
            <%= link_to t('users.homepage.all_products'), products_path, class: 'btn btn-secondary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= link_to t('cart.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
<%= link_to t('users.homepage.all_products'), products_path, class: 'btn btn-secondary' %>
