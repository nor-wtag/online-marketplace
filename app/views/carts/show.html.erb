<h1><%= t('cart.title') %></h1>
<% if @cart_items.empty? %>
  <p><%= t('cart.empty') %></p>
<% else %>
  <table>
    <tr>
      <th><%= t('cart.product') %></th>
      <th><%= t('cart.quantity') %></th>
      <th><%= t('cart.price') %></th>
      <th><%= t('cart.total') %></th>
      <th><%= t('cart.actions') %></th>
    </tr>
    <% @cart_items.each do |item| %>
      <tr>
        <td><%= item.product.title %></td>
        <td>
          <%= form_with url: cart_item_path(item), method: :patch, local: true do |f| %>
            <%= f.number_field :quantity, value: item.quantity, min: 1 %>
            <%= f.submit t('cart.update') %>
          <% end %>
        </td>
        <td><%= number_to_currency(item.product.price) %></td>
        <td><%= number_to_currency(item.product.price * item.quantity) %></td>
        <td>
          <% if can?(:destroy, item) %>
            <%= link_to t('cart.remove'), delete_cart_item_path(item), method: :get, class: "btn btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
  <p><strong><%= t('cart.total_label') %>:</strong> <%= number_to_currency(current_user.cart.cart_items.sum { |item| item.quantity * item.product.price }) %></p>
  <%= button_to t('cart.place_order'), orders_path, method: :post, class: 'btn btn-primary' %>
<% end %>

<%= link_to t('cart.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
