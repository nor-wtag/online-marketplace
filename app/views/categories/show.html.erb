<h1><%= t('categories.details') %></h1>

<p><strong><%= t('categories.name') %>:</strong> <%= @category.name %></p>
<p><strong><%= t('categories.description') %>:</strong> <%= @category.description %></p>

<h2><%= t('categories.associated_products') %></h2>
<% if @category.products.any? %>
  <ul>
    <% @category.products.each do |product| %>
      <li><%= link_to product.title, product_path(product) %></li>
    <% end %>
  </ul>
<% else %>
  <p><%= t('categories.no_associated_products') %></p>
<% end %>

<% if can?(:update, @category) %>
  <%= link_to t('categories.edit'), edit_category_path(@category), class: 'btn btn-warning' %>
<% end %>
<% if can?(:delete, @category) %>
  <%= link_to t('categories.delete'), delete_category_path(@category), method: :get, class: 'btn btn-danger' %>
<% end %>

<%= link_to t('categories.back_to_categories'), categories_path, class: 'btn btn-secondary' %>
<%= link_to t('categories.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
