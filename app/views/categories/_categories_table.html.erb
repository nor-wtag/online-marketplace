<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th><%= t('categories.name') %></th>
      <th><%= t('categories.description') %></th>
      <th><%= t('categories.actions') %></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
        <td><%= category.description %></td>
        <td>
          <%= link_to t('categories.show'), category_path(category), class: 'btn btn-info btn-sm' %>
          <% if can?(:update, category) %>
            <%= link_to t('categories.edit'), edit_category_path(category), class: 'btn btn-warning btn-sm' %>
          <% end %>
          <% if can?(:destroy, category) %>
            <%= link_to t('categories.delete'), delete_category_path(category), method: :get, class: 'btn btn-danger btn-sm' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
