<% if can?(category.new_record? ? :create : :update, category) %>
  <%= form_with(model: category, local: true, class: "needs-validation") do |f| %>
    <% if category.errors.any? %>
      <div id="error_explanation" class="alert alert-danger">
        <h2><%= pluralize(category.errors.count, t('errors.count')) %> <%= t('errors.prohibited', item: t('categories.category')) %></h2>
        <ul>
          <% category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :name, t('categories.name'), class: "form-label" %>
      <%= f.text_field :name, required: true, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :description, t('categories.description'), class: "form-label" %>
      <%= f.text_area :description, required: true, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :products, t('categories.select_products'), class: "form-label" %>
      <%= f.collection_select :product_ids, Product.all, :id, :title, {}, { multiple: true, class: "form-select" } %>
    </div>

    <div>
      <%= f.submit category.new_record? ? t('categories.create') : t('categories.update'), class: 'btn btn-primary' %>
    </div>
  <% end %>
<% else %>
  <p><%= t('categories.unauthorized_action') %></p>
<% end %>

<%= link_to t('categories.back_to_list'), categories_path, class: 'btn btn-secondary mt-2' %>
