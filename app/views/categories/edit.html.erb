<h1><%= @category.new_record? ? t('categories.new') : t('categories.edit') %></h1>

<% if can?(:update, @category) %>
  <%= render 'form', category: @category %>
<% else %>
  <p><%= t('categories.unauthorized_edit') %></p>
<% end %>

<%= link_to t('categories.back_to_categories'), categories_path, class: 'btn btn-secondary' %>
