<h1 class="mb-4"><%= t('products.index.title') %></h1>

<% if can?(:create, Product) %>
  <div class="mb-3">
    <%= link_to t('products.index.new_product_button'), new_product_path, class: 'btn btn-primary' %>
  </div>
<% end %>

<div class="card shadow">
  <div class="card-body">
    <%= render 'products_table' %>
  </div>
</div>

<div class="mt-3">
  <%= link_to t('products.index.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
</div>
