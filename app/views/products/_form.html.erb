<% if can?(product.new_record? ? :create : :update, product) %>
  <%= form_with model: product, local: true do |f| %>
    <% if product.errors.any? %>
      <div id="error_explanation">
        <h2><%= t('products.form.error_title', count: product.errors.count) %></h2>
        <ul>
          <% product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, t('products.form.title_label') %>
      <%= f.text_field :title, required: true %>
    </div>

    <div>
      <%= f.label :description, t('products.form.description_label') %>
      <%= f.text_area :description, required: true %>
    </div>

    <div>
      <%= f.label :price, t('products.form.price_label') %>
      <%= f.number_field :price, required: true, step: 0.01 %>
    </div>

    <div>
      <%= f.label :stock, t('products.form.stock_label') %>
      <%= f.number_field :stock, required: true, min: 0 %>
    </div>

    <div>
      <%= f.label :categories, t('products.form.categories_label') %>
      <%= f.collection_select :category_ids, Category.all, :id, :name, {}, { multiple: true } %>
    </div>

    <div>
      <%= f.submit product.new_record? ? t('products.form.create_button') : t('products.form.update_button') %>
    </div>
  <% end %>
<% else %>
  <p><%= t('products.form.unauthorized_message') %></p>
<% end %>
