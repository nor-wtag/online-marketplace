<% if can?(product.new_record? ? :create : :update, product) %>
  <%= form_with model: product, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
    <% if product.errors.any? %>
      <div class="alert alert-danger">
        <h4 class="alert-heading"><%= t('products.form.error_title', count: product.errors.count) %></h4>
        <ul>
          <% product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :title, t('products.form.title_label'), class: "form-label" %>
      <%= f.text_field :title, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :description, t('products.form.description_label'), class: "form-label" %>
      <%= f.text_area :description, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :price, t('products.form.price_label'), class: "form-label" %>
      <%= f.number_field :price, class: "form-control", required: true, step: 0.01 %>
    </div>

    <div class="mb-3">
      <%= f.label :stock, t('products.form.stock_label'), class: "form-label" %>
      <%= f.number_field :stock, class: "form-control", required: true, min: 0 %>
    </div>

    <div class="mb-3">
      <%= f.label :categories, t('products.form.categories_label'), class: "form-label" %>
      <%= f.collection_select :category_ids, Category.all, :id, :name, {}, { multiple: true, class: "form-select" } %>
    </div>

    <div class="mb-3">
    <%= f.label :image, t('products.form.image_label'), class: "form-label" %>
      <%= f.file_field :image, class: "form-control" %>
    </div>

    <div class="d-grid">
      <%= f.submit product.new_record? ? t('products.form.create_button') : t('products.form.update_button'), class: "'btn btn-primary btn-lg w-10" %>
    </div>
  <% end %>
<% else %>
  <p class="text-danger"><%= t('products.form.unauthorized_message') %></p>
<% end %>
