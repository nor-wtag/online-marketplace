<h1 class="mb-4"><%= t('products.index.title') %></h1>

<% if can?(:create, Product) %>
  <div class="mb-3">
    <%= link_to t('products.index.new_product_button'), new_product_path, class: 'btn btn-primary' %>
  </div>
<% end %>

<div class="row row-cols-2 row-cols-md-4 g-3">
  <% @products.each do |product| %>
    <div class="col">
      <div class="card h-100 shadow">
        <% if product.image.attached? %>
          <%= image_tag product.image.variant(resize_to_fill: [150, 150]).processed, class: "card-img-top", alt: product.title %>
        <% else %>
          <%= image_tag 'placeholder.png', class: "card-img-top", alt: 'Placeholder image' %>
        <% end %>
        <div class="card-body text-center">
          <h6 class="card-title mb-2"><%= product.title %></h6>
          <p class="card-text mb-2 text-muted"><%= format_price(product.price) %></p>
        </div>
        <div class="card-footer d-flex justify-content-center">
          <%= link_to t('products.index.view_product'), product_path(product), class: 'btn btn-sm btn-primary me-1' %>
          <% if can?(:update, product) %>
            <%= link_to t('products.index.edit_product'), edit_product_path(product), class: 'btn btn-sm btn-warning me-1' %>
          <% end %>
          <% if can?(:destroy, product) %>
            <%= link_to t('products.index.delete_product'), delete_product_path(product), method: :get, class: 'btn btn-sm btn-danger' %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

