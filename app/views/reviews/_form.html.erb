<%= form_with(model: [@product, @review], local: true) do |f| %>
  <% if @review.errors.any? %>
    <div id="error_explanation">
      <h2><%= t('reviews.form.errors_title', count: @review.errors.count) %></h2>
      <ul>
        <% @review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :rating, t('reviews.form.rating') %>
    <%= f.number_field :rating, in: 1..5, step: 1 %>
  </div>

  <div class="field">
    <%= f.label :comment, t('reviews.form.comment') %>
    <%= f.text_area :comment %>
  </div>

  <div class="actions">
    <%= f.submit t('reviews.form.submit') %>
  </div>
<% end %>
