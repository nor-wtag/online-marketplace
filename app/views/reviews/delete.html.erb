<% @page_title = "Delete Review" %>

<div class='review delete'>
  <h2>Delete Review</h2>

  <%= form_with(model: [@product, @review], url: product_review_path(@product, @review), method: :delete, local: true) do |f| %>
    <p>Are you sure you want to delete this review?</p>
    <p><strong>Rating:</strong> <%= @review.rating %></p>
    <p><strong>Comment:</strong> <%= @review.comment %></p>
    <div class='form-buttons'>
      <%= f.submit("Delete Review", class: 'btn btn-danger') %>
      <%= link_to 'Cancel', product_path(@product), class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>

<%= link_to 'Back to the Product', product_path(@product), class: 'btn btn-secondary' %>
