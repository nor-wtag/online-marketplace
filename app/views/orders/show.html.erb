<h1><%= t('orders.show.details_title') %></h1>
<p><strong><%= t('orders.show.status_label') %>:</strong> <%= @order.status.humanize %></p>

<h2><%= t('orders.show.items_title') %></h2>
<table>
  <thead>
    <tr>
      <th><%= t('orders.show.product') %></th>
      <th><%= t('orders.show.available') %></th>
      <th><%= t('orders.show.quantity') %></th>
      <th><%= t('orders.show.price') %></th>
      <th><%= t('orders.show.subtotal') %></th>
      <th><%= t('orders.show.status') %></th>
      <th><%= t('orders.show.review') %></th>
    </tr>
  </thead>
  <tbody>
    <% @order_items.each do |item| %>
      <tr>
        <td><%= item.product.present? ? link_to(item.product.title, product_path(item.product)) : t('orders.show.unavailable_product') %></td>
        <td><%= item.availibility == 'available' ? t('orders.show.available_yes') : t('orders.show.available_no') %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.price) %></td>
        <td><%= number_to_currency(item.price * item.quantity) %></td>
        <td><%= item.status.humanize %></td>

        <td>
          <% if current_user.admin? && item.status == 'sent_to_delivery_company' %>
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.hidden_field :status, value: 'rider_assigned' %>
              <%= f.label :rider_id, t('orders.show.assign_rider') %>
              <%= f.collection_select :rider_id, User.where(role: :rider), :id, :username, prompt: t('orders.show.select_rider') %>
              <%= f.submit t('orders.show.assign_rider_submit') %>
            <% end %>
          <% end %>

          <% if current_user.seller? && current_user == item.product.user && %w[pending sent_to_delivery_company].include?(item.status) %>
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.select :status, options_for_select([
                [t('orders.show.status_pending'), 'pending'],
                [t('orders.show.status_sent_to_delivery'), 'sent_to_delivery_company']
              ], selected: item.status) %>
              <%= f.submit t('orders.show.update_status_submit') %>
            <% end %>
          <% end %>

          <% if current_user.rider? && item.status == 'rider_assigned' && item.rider_id == current_user.id %>
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.hidden_field :status, value: 'delivered' %>
              <%= f.submit t('orders.show.mark_as_delivered') %>
            <% end %>
          <% end %>

          <% if current_user.buyer? && item.status == 'delivered' %>
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.hidden_field :status, value: 'received' %>
              <%= f.submit t('orders.show.confirm_received') %>
            <% end %>
          <% end %>
        </td>

        <td>
          <% if current_user.buyer? && item.status == 'received' %>
            <% existing_review = item.product.reviews.find_by(user_id: current_user.id) %>
            <% if existing_review %>
              <%= link_to t('orders.show.edit_review'), edit_product_review_path(item.product, existing_review), class: 'btn btn-warning' %>
            <% else %>
              <%= link_to t('orders.show.add_review'), new_product_review_path(item.product), class: 'btn btn-primary' %>
            <% end %>
          <% else %>
            <% if current_user.buyer? %>
              <p><%= t('orders.show.add_review_after_received') %></p>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to t('orders.back_to_orders'), orders_path, class: 'btn btn-secondary' %>
<%= link_to t('orders.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
