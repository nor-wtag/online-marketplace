<h1>Order Details</h1>
<p><strong>Order Status:</strong> <%= @order.status.humanize %></p>

<h2>Order Items</h2>
<table>
  <thead>
    <tr>
      <th>Product</th>
      <th>Available</th>
      <th>Quantity</th>
      <th>Price</th>
      <th>Subtotal</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @order_items.each do |item| %>
      <tr>
        <td><%= item.product&.title || 'Unavailable Product' %></td>
        <td><%= item.availibility == 'available' ? 'Yes' : 'No' %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.price) %></td>
        <td><%= number_to_currency(item.price * item.quantity) %></td>
        <td><%= item.status.humanize %></td>

        <td>
          <% if current_user.admin? && item.status == 'sent_to_delivery_company' %>
            <!-- Admin can assign a rider to order items with status "sent_to_delivery_company" -->
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.hidden_field :status, value: 'rider_assigned' %>
              <%= f.label :rider_id, "Assign Rider" %>
              <%= f.collection_select :rider_id, User.where(role: :rider), :id, :username, prompt: "Select Rider" %>
              <%= f.submit "Assign Rider" %>
            <% end %>

          <% elsif current_user.seller? && current_user == item.product.user && %w[pending sent_to_delivery_company].include?(item.status) %>
            <!-- Seller's options for updating order item status -->
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.select :status, options_for_select([
                ['Pending', 'pending'],
                ['Sent to Delivery Company', 'sent_to_delivery_company']
              ], selected: item.status) %>
              <%= f.submit "Update Status" %>
            <% end %>

          <% elsif current_user.rider? && item.status == 'rider_assigned' && item.rider_id == current_user.id %>
            <!-- Rider can mark assigned items as "Delivered" -->
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.hidden_field :status, value: 'delivered' %>
              <%= f.submit "Mark as Delivered" %>
            <% end %>

          <% elsif current_user.buyer? && item.status == 'delivered' %>
            <!-- Buyer can mark items as "Received" after they are delivered -->
            <%= form_with url: "/orders/#{@order.id}/order_items/#{item.id}/update_status", method: :patch, local: true do |f| %>
              <%= f.select :status, options_for_select([['Received', 'received']], selected: item.status) %>
              <%= f.submit "Confirm Received" %>
            <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%end%>
<%= link_to 'Back to Orders', orders_path, class: 'btn btn-secondary' %>
<%= link_to 'Back to Homepage', homepage_path, class: 'btn btn-secondary' %>
