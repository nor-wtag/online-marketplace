          <td><%= order.status.humanize %></td>
          <td>
            <%= link_to t('orders.index.manage_order_items'), order_path(order), class: 'btn btn-info btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<div class="mt-3">
  <%= link_to t('orders.back_to_homepage'), homepage_path, class: 'btn btn-secondary' %>
</div>

