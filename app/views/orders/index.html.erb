<h1><%= t('orders.index.title') %></h1>

<% if current_user.buyer? %>
  <h2><%= t('orders.index.buyer_orders') %></h2>
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th><%= t('orders.index.order_number') %></th>
        <th><%= t('orders.index.total_price') %></th>
        <th><%= t('orders.index.status') %></th>
        <th><%= t('orders.index.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.id %></td>
          <td><%= number_to_currency(order.total_price) %></td>
          <td><%= order.status.humanize %></td>
          <td>
            <%= link_to t('orders.index.view_order'), order_path(order), class: 'btn btn-info btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% elsif current_user.seller? %>
  <h2><%= t('orders.index.seller_orders') %></h2>
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th><%= t('orders.index.order_number') %></th>
        <th><%= t('orders.index.buyer') %></th>
        <th><%= t('orders.index.status') %></th>
        <th><%= t('orders.index.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.user_id %></td>
          <td><%= order.status.humanize %></td>
          <td>
            <%= link_to t('orders.index.view_order'), order_path(order), class: 'btn btn-info btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

<% elsif current_user.rider? %>
  <h2><%= t('orders.index.rider_orders') %></h2>
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
