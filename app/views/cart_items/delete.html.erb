<% @page_title = t('cart_items.delete_page_title') %>

<% if can?(:destroy, @cart_item) %>
  <div class='cart item delete'>
    <h2><%= t('cart_items.delete_title') %></h2>

    <%= form_with(model: @cart_item, local: true, method: :delete) do |f| %>
      <p><%= t('cart_items.delete_confirmation') %></p>
      <div class='form-buttons'>
        <%= f.submit t('cart_items.delete_button'), class: 'btn btn-danger' %>
      </div>
    <% end %>
  </div>
<% else %>
  <p><%= t('cart_items.unauthorized_delete') %></p>
<% end %>

<%= link_to t('cart_items.back_to_cart'), cart_path, class: 'btn btn-primary' %>
