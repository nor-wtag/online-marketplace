<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <% if can?(:destroy, @cart_item) %>
        <div class="card">
          <div class="card-header bg-danger text-white">
            <h2 class="h4"><%= t('cart_items.delete_title') %></h2>
          </div>
          <div class="card-body">
            <%= form_with(model: @cart_item, local: true, method: :delete) do |f| %>
              <p><%= t('cart_items.delete_confirmation') %></p>
              <div class="form-buttons">
                <%= f.submit t('cart_items.delete_button'), class: 'btn btn-danger' %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="alert alert-danger" role="alert">
          <p><%= t('cart_items.unauthorized_delete') %></p>
        </div>
      <% end %>
      <%= link_to t('cart_items.back_to_cart'), cart_path, class: 'btn btn-secondary mt-3' %>
    </div>
  </div>
</div>
