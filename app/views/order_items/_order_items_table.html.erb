<h2><%= t('order_items.title') %></h2>
<table>
  <thead>
    <tr>
      <th><%= t('order_items.product') %></th>
      <th><%= t('order_items.quantity') %></th>
      <th><%= t('order_items.price') %></th>
      <th><%= t('order_items.subtotal') %></th>
      <th><%= t('order_items.status') %></th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_items.each do |item| %>
      <tr>
        <td><%= item.product.title %></td>
        <td><%= item.quantity %></td>
        <td><%= number_to_currency(item.price) %></td>
        <td><%= number_to_currency(item.price * item.quantity) %></td>
        <td><%= item.status.humanize %></td>
        <% if current_user.seller? %>
          <td>
            <%= form_with url: update_status_order_item_path(item), method: :patch, local: true do |f| %>
              <%= f.select :status, options_for_select(t('order_items.status_options'), selected: item.status) %>
              <%= f.submit t('order_items.update_status') %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to t('order_items.back_to_order'), orders_path %>
