<div class="container mt-5">
  <h2 class="text-danger"><%= t('registrations.delete_account.title') %></h2>
  <p><%= t('registrations.delete_account.warning') %></p>

  <%= form_with url: destroy_user_path, method: :delete do |f| %>
    <div class="mb-3">
      <%= f.submit t('registrations.confirm_delete'), data: { confirm: t('registrations.delete_account.confirm_prompt') }, class: "btn btn-danger" %>
    </div>
  <% end %>

  <%= link_to t('registrations.cancel_delete.cancel'), homepage_path, class: 'btn btn-secondary' %>
</div>
